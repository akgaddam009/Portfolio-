# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# Large legacy video assets — keep local, deploy uses compressed .mp4.
# Every existing .mov already in the repo stays tracked (don't lose data);
# this rule only prevents NEW .mov files from getting added in future
# deploys. To untrack the current ones, see SECURITY_AUDIT.md.
public/images/system/overview.mov
public/images/**/*.mov

# Untracked giant media that snuck in via wildcard adds — keep local, don't push
public/images/system/Screen Recording*
public/images/Fancode Homepage /
public/images/reputation/After .mov
public/images/reputation/Before .mov
public/images/astra/Meet - Persona Research Group*

# Reference materials downloaded into the repo, not part of the build
awesome-design-md-main/
awesome-design-md-main.zip

# Local dev scaffolding — not part of the deployed site
.agents/
# Ignore .claude/ contents but keep project-level skills checked in
.claude/*
!.claude/skills/
!.claude/skills/**
skills-lock.json
writer.md

# Local generated exports + helper scripts (not deployed)
/portfolio-export.md
/scripts/
/public/images/lorenzo-lanfranconi-ex-22-f.jpg
