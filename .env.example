# Password that gates confidential case studies.
# Set this in your Vercel dashboard under Settings → Environment Variables.
# Without this, the password gate will return a config error in production.
CASE_STUDY_PASSWORD=your-password-here

# Google Analytics 4 — get from analytics.google.com → Admin → Data Streams → your stream → Measurement ID
NEXT_PUBLIC_GA_MEASUREMENT_ID=G-XXXXXXXXXX

# Microsoft Clarity — get from clarity.microsoft.com → your project → Settings → Overview → Project ID
NEXT_PUBLIC_CLARITY_PROJECT_ID=xxxxxxxxxx
